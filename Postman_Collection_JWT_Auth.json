						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 403) {",
									"    console.log(\"✅ Bloqueio funcionando! Não pode se cadastrar como ADMIN\");",
									"} else {",
									"    console.log(\"❌ FALHA DE SEGURANÇA! Conseguiu se cadastrar como ADMIN\");",
									"}"
								],
