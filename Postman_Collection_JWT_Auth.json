				{
					"name": "1. Signup - Registrar Usuario IDOSO",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Salvar o token JWT retornado",
									"if (pm.response.code === 201) {",
									"    pm.environment.set(\"jwt_token\", pm.response.text());",
									"    console.log(\"✅ Usuário cadastrado com sucesso!\");",
									"} else {",
									"    console.log(\"❌ Erro no cadastro:\", pm.response.text());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"João Silva Santos\",\n    \"username\": \"joao.silva\",\n    \"email\": \"joao.silva@email.com\",\n    \"password\": \"senha123456\",\n    \"roleType\": \"IDOSO\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/signup",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"signup"
							]
						},
						"description": "Registrar um novo usuário no sistema (público - não precisa autenticação)"
					},
					"response": []
				},
