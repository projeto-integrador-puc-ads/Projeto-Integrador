				{
					"name": "3. Login - Obter Token JWT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Salvar o token JWT retornado",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"jwt_token\", jsonData.accessToken);",
									"    console.log(\"✅ Login realizado com sucesso!\");",
									"    console.log(\"🔑 Token JWT:\", jsonData.accessToken);",
									"} else {",
									"    console.log(\"❌ Erro no login:\", pm.response.text());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usernameOrEmail\": \"joao.silva@email.com\",\n    \"password\": \"senha123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Fazer login e receber token JWT (público - não precisa autenticação)"
					},
					"response": []
				}
			],
			"description": "Endpoints públicos de autenticação (signup e login)"
		},
